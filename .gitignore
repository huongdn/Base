# This .gitignore file should be placed at the root of your Unity project.

# --- Unity Temporary and Generated Files ---
/[Ll]ibrary/
/[Tt]emp/
/[Oo]bj/
/[Bb]uild/
/[Bb]uilds/
/[Cc]apabilities/
/[Mm]emoryCaptures/
/[Ll]ogs/
/[Mm]irror/

# --- Asset Store Packages ---
# Comment this out if you want to include Asset Store packages in version control
/[Aa]ssets/AssetStoreTools*

# --- Autogenerated Visual Studio / Rider / VS Code Files ---
*.csproj
*.unityproj
*.sln
*.suo
*.tmp
*.user
*.userprefs
*.pidb
*.booproj
*.svd
*.pdb
*.opendb
*.VC.db

# --- Unity Internal Informative Files ---
sysinfo.txt

# --- Crash Reports ---
[Cc]rash_report*

# --- OS Generated Files ---
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db

# --- Builds ---
# Prevents built executables from being pushed to git
/[Bb]uilds/
/[Pp]roduction/

# --- Unity Package Manager ---
/[Pp]ackages/*
!/[Pp]ackages/manifest.json
!/[Pp]ackages/packages-lock.json

# --- User-specific Editor Settings ---
/[Uu]ser[Ss]ettings/

# --- JetBrains Rider ---
.idea/

# --- VS Code ---
.vscode/

# --- Server ---
server/node_modules/
server/dist/
server/.env