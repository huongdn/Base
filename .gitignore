# This .gitignore file should be placed at the root of your Unity project.
#
# --- Unity Temporary and Generated Files ---
/[Ll]ibrary/
/[Tt]emp/
/[Oo]bj/
/[Bb]uild/
/[Bb]uilds/
/[Cc]apabilities/
/[Mm]emoryCaptures/
/[Ll]ogs/
/[Mm]irror/

# --- Asset Store Packages ---
# Thường các package tải từ Asset Store về không nên push lên git nếu dự án open-source để tránh bản quyền, 
# hoặc nếu dự án cá nhân/nội bộ thì bạn có thể comment dòng này lại để lưu trữ.
/[Aa]ssets/AssetStoreTools*

# --- Autogenerated Visual Studio / Rider / VS Code Files ---
*.csproj
*.unityproj
*.sln
*.suo
*.tmp
*.user
*.userprefs
*.pidb
*.booproj
*.svd
*.pdb
*.opendb
*.VC.db

# --- Unity internal informative files ---
sysinfo.txt

# --- Unity精简版 / Crash reports ---
[Cc]rash_report*

# --- OS Generated Files ---
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db

# --- Builds ---
# Nếu bạn build game ra thư mục trong dự án, dòng này sẽ chặn không cho push file thực thi lên git
/[Bb]uilds/
/[Pp]roduction/

# --- UPM (Unity Package Manager) cache ---
/[Pp]ackages/manifest.json
/[Pp]ackages/packages-lock.json
# Không bỏ qua manifest.json nhưng bỏ qua các file tạm trong Packages
/[Pp]ackages/*
!/[Pp]ackages/manifest.json
!/[Pp]ackages/packages-lock.json