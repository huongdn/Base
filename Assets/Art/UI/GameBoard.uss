.root {
    flex: 1;
    align-items: center;
    justify-content: center;
    background-color: #1a1a2e;
}

.network-bar {
    width: 100%;
    max-width: 520px;
    margin-bottom: 16px;
    padding: 12px 16px;
    background-color: #16213e;
    border-radius: 8px;
    border-width: 1px;
    border-color: #0f3460;
}

.network-field {
    margin-bottom: 8px;
    color: #eaeaea;
}

.network-actions {
    flex-direction: row;
    margin-bottom: 8px;
}

.network-btn {
    flex-grow: 1;
    margin-right: 8px;
    padding: 8px 12px;
    background-color: #0f3460;
    color: #eaeaea;
    border-width: 0;
    border-radius: 6px;
}

.network-btn--join {
    margin-right: 0;
    background-color: #1b998b;
}

.connection-label {
    font-size: 14px;
    color: #a8b2d1;
}

.status {
    font-size: 24px;
    color: #eaeaea;
    margin-bottom: 20px;
}

.board {
    flex-direction: column;
}

.row {
    flex-direction: row;
}

.cell {
    width: 100px;
    height: 100px;
    font-size: 48px;
    margin: 4px;
    background-color: #16213e;
    color: #eaeaea;
    border-color: #0f3460;
    border-width: 2px;
    border-radius: 8px;
}

.cell:hover {
    background-color: #0f3460;
}

.restart {
    margin-top: 20px;
    padding: 10px 30px;
    font-size: 18px;
    background-color: #e94560;
    color: white;
    border-width: 0;
    border-radius: 6px;
}

.cell--winner {
    background-color: #e94560;
    color: white;
    border-color: #ff6b6b;
}

.cell--draw {
    background-color: #4a4a6a;
    color: #aaaaaa;
}