<ui:UXML xmlns:ui="UnityEngine.UIElements"
        xmlns:uie="UnityEditor.UIElements">
    <Style src="GameBoard.uss"/>
    <ui:VisualElement name="root" class="root">
        <ui:Label name="status-label" text="Player X's Turn" class="status"/>
        <ui:VisualElement name="board" class="board">
            <ui:VisualElement class="row">
                <ui:Button name="cell-0" class="cell"/>
                <ui:Button name="cell-1" class="cell"/>
                <ui:Button name="cell-2" class="cell"/>
            </ui:VisualElement>
            <ui:VisualElement class="row">
                <ui:Button name="cell-3" class="cell"/>
                <ui:Button name="cell-4" class="cell"/>
                <ui:Button name="cell-5" class="cell"/>
            </ui:VisualElement>
            <ui:VisualElement class="row">
                <ui:Button name="cell-6" class="cell"/>
                <ui:Button name="cell-7" class="cell"/>
                <ui:Button name="cell-8" class="cell"/>
            </ui:VisualElement>
        </ui:VisualElement>
        <ui:Button name="restart-btn" text="Restart" class="restart"/>
    </ui:VisualElement>
</ui:UXML>